# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=http

# Local Postgres from docker-compose
DATABASE_URL=postgres://seatase:seatase@localhost:5432/seatase

# Production refuses to start with this value or anything under 32 characters.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars

# false on localhost (http), true once deployed behind https
COOKIE_SECURE=false

# How often each open live-updates stream gets a heartbeat event (ms)
SSE_HEARTBEAT_MS=25000
