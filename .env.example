# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=http

# Local Postgres from docker-compose
DATABASE_URL=postgres://seatase:seatase@localhost:5432/seatase

# Production refuses to start with this value or anything under 32 characters.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars

# Key for the NID fingerprint (one NID = one account). Set it once and NEVER change it:
# we don't keep full NIDs, so old fingerprints can't be recomputed with a new key.
NID_PEPPER=dev-only-nid-pepper-never-rotate-at-least-32

# false on localhost (http), true once deployed behind https
COOKIE_SECURE=false

# How often each open live-updates stream gets a heartbeat event (ms)
SSE_HEARTBEAT_MS=25000

# Show the phone OTP code on screen instead of sending an SMS (the demo has no SMS provider)
DEMO_MODE=true

# Key for the /dev demo routes (the Seat Race). Sent as the X-Demo-Key header.
# Refuses to start in production with DEMO_MODE on unless this is a real key of 32+ characters.
DEMO_KEY=dev-only-demo-key-change-me-at-least-32-chars

# Ports docker compose publishes on your machine. Change them if something else already uses them
# (e.g. a local Postgres on 5432). Tests follow DB_PORT too: DB_PORT=5433 npm test
# DB_PORT=5432
# API_PORT=4000
# WEB_PORT=3000
